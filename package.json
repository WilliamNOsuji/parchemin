{
  "name": "parchemin",
  "productName": "Parchemin",
  "description": "A calm, local-first writing app for stories and the characters in them.",
  "author": "William Osuji",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "version": "0.1.1",
  "type": "module",
  "main": "dist-electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "site": "vite --config vite.site.config.ts",
    "build:site": "vite build --config vite.site.config.ts",
    "build:pages": "tsc -b && node scripts/build-pages.mjs",
    "build:desktop": "tsc -b && vite build && tsc -p electron",
    "desktop": "npm run build:desktop && electron .",
    "desktop:dev": "tsc -p electron && node scripts/desktop-dev.mjs",
    "dist": "npm run build:desktop && electron-builder",
    "dist:win": "npm run build:desktop && electron-builder --win",
    "publish:update": "node scripts/publish-update.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "@tiptap/extension-character-count": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/extension-typography": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "jszip": "^3.10.2",
    "marked": "~18.0.14",
    "nanoid": "^6.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.7.1",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
